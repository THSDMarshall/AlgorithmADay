// Staff-owned spreadsheet: Extensions > Apps Script. No public web app needed.
function onOpen(){SpreadsheetApp.getUi().createMenu('Algorithm A Day').addItem('Import student CSV','importProgress').addToUi();}
function importProgress(){const ui=SpreadsheetApp.getUi();const id=ui.prompt('Drive file ID of student progress CSV');if(id.getSelectedButton()!==ui.Button.OK)return;const label=ui.prompt('School-approved student identifier');if(label.getSelectedButton()!==ui.Button.OK)return;const rows=Utilities.parseCsv(DriveApp.getFileById(id.getResponseText().trim()).getBlob().getDataAsString());if(rows.length!==31||rows[0].join(',')!=='Challenge,Title,Topic,Available,Best,Latest,Attempts,Complete')throw Error('Unexpected CSV format');const safe=v=>/^[=+\-@\t\r]/.test(String(v))?"'"+v:String(v);const ss=SpreadsheetApp.getActive();const sh=ss.getSheetByName('Progress')||ss.insertSheet('Progress');if(!sh.getLastRow())sh.appendRow(['Imported','Student','Challenge','Title','Topic','Available','Best','Latest','Attempts','Complete']);const data=rows.slice(1).map(r=>{if(r.length!==8)throw Error('Invalid row');return [new Date(),safe(label.getResponseText()),...r.map(safe)];});sh.getRange(sh.getLastRow()+1,1,data.length,10).setValues(data);}
